<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BluetoothManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BluetoothManager"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="BlueIDE">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <NavigationView x:Name="MainNav"
                        IsSettingsVisible="True"
                        PaneDisplayMode="Left"
                        OpenPaneLength="260"
                        SelectionChanged="MainNav_SelectionChanged"
                        AlwaysShowHeader="True">
            <NavigationView.Header>
                <TextBlock x:Name="PageHeader" Text="Devices" FontSize="20" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </NavigationView.Header>
            <NavigationView.PaneFooter>
                <Border Padding="16,12" Margin="4,0,4,12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="ShellConnectionDot" Width="8" Height="8"
                                 Fill="{ThemeResource StatusDisconnectedBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="ShellConnectionText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavDevices" Tag="devices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE702;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavAnalyzer" Tag="analyzer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB4A;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <InfoBar x:Name="DisconnectWarningBar"
                             Severity="Warning" IsOpen="False" IsClosable="True"
                             Style="{StaticResource PageInfoBarStyle}"
                             Margin="18,0,18,0"/>
                    <InfoBar x:Name="TrialReminderBar"
                             Severity="Informational" IsOpen="False" IsClosable="True"
                             Style="{StaticResource PageInfoBarStyle}"
                             Margin="18,0,18,0">
                        <InfoBar.ActionButton>
                            <Button x:Name="TrialReminderBuyButton" Click="TrialReminderBuy_Click"
                                    Style="{StaticResource AccentButtonStyle}"/>
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
                <Frame x:Name="ContentFrame" Grid.Row="1" Padding="18"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
