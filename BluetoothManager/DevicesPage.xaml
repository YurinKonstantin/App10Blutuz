<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BluetoothManager.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BluetoothManager"
    xmlns:services="using:BluetoothManager.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <DataTemplate x:Key="DeviceCardTemplate" x:DataType="local:BluetoothDeviceModel">
            <Border x:Name="DeviceCard" Style="{StaticResource DeviceCardBorderStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Click="Favorite_Click" Tag="{x:Bind Id}"
                            Background="Transparent" BorderThickness="0" Padding="4" Margin="0,0,8,0"
                            VerticalAlignment="Center" x:Uid="FavoriteButton">
                        <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" FontSize="16"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Button>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"
                                           TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                <Border Style="{StaticResource TypeBadgeBorderStyle}">
                                    <TextBlock Text="{x:Bind BluetoothType}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                                <TextBlock Text="{x:Bind BatteryString, Mode=OneWay}" FontSize="11"
                                           Visibility="{x:Bind HasBattery, Mode=OneWay}"
                                           Foreground="{ThemeResource BrandAccentBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Ellipse Width="8" Height="8" Fill="{x:Bind DistanceBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind DistanceSummary, Mode=OneWay}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{x:Bind DistanceBrush, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{x:Bind MacAddress}"/>
                            <Run Text=" · "/>
                            <Run Text="{x:Bind Type, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{x:Bind RssiString, Mode=OneWay}"/>
                        </TextBlock>
                        <Grid Margin="0,2,0,0" Width="100" Height="4" HorizontalAlignment="Left"
                              Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="2">
                            <Border Width="{x:Bind RssiBarWidth, Mode=OneWay}" Height="4"
                                    HorizontalAlignment="Left" CornerRadius="2"
                                    Background="{x:Bind DistanceBrush, Mode=OneWay}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Content="{x:Bind PairButtonText, Mode=OneWay}" Click="Pair_Click"
                                Tag="{x:Bind Id}" Height="28" Padding="10,0" FontSize="12"
                                Visibility="{x:Bind PairButtonVisibility, Mode=OneWay}"/>
                        <Button Content="{x:Bind ConnectButtonText}" Click="Connect_Click"
                                Tag="{x:Bind Id}" Height="28" Padding="12,0" FontSize="12"
                                Visibility="{x:Bind ConnectButtonVisibility, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DeviceCardCompactTemplate" x:DataType="local:BluetoothDeviceModel">
            <Border Style="{StaticResource DeviceCardBorderCompactStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Click="Favorite_Click" Tag="{x:Bind Id}"
                            Background="Transparent" BorderThickness="0" Padding="2" Margin="0,0,4,0"
                            VerticalAlignment="Center" x:Uid="FavoriteButton">
                        <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" FontSize="14"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Button>

                    <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"
                                           TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                <Border Style="{StaticResource TypeBadgeBorderStyle}" Padding="4,0">
                                    <TextBlock Text="{x:Bind BluetoothType}" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{x:Bind DistanceBrush, Mode=OneWay}"/>
                                <TextBlock Text="{x:Bind ApproximateDistance, Mode=OneWay}" FontSize="10"
                                           FontWeight="SemiBold" Foreground="{x:Bind DistanceBrush, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{x:Bind MacAddress}"/>
                            <Run Text=" · "/>
                            <Run Text="{x:Bind DistanceLabel, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{x:Bind RssiString, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button Content="{x:Bind PairButtonText, Mode=OneWay}" Click="Pair_Click"
                                Tag="{x:Bind Id}" Height="26" Padding="8,0" FontSize="11"
                                Visibility="{x:Bind PairButtonVisibility, Mode=OneWay}"/>
                        <Button Content="{x:Bind ConnectButtonText}" Click="Connect_Click"
                                Tag="{x:Bind Id}" Height="26" Padding="10,0" FontSize="11"
                                Visibility="{x:Bind ConnectButtonVisibility, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
    <Grid x:Name="RootLayout">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="2*"/>
            <ColumnDefinition x:Name="RightCol" Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="*"/>
            <RowDefinition x:Name="BottomRow" Height="0"/>
        </Grid.RowDefinitions>

        <!-- Device list -->
        <Grid x:Name="DevicesPanel" Grid.Column="0" Grid.Row="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="ScanToolbar" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10" VerticalAlignment="Center">
                <Button x:Name="ScanButton" x:Uid="ScanButton" Click="ScanButton_Click" Style="{StaticResource AccentButtonStyle}"/>
                <ProgressRing x:Name="ScanProgress" IsActive="False" Width="20" Height="20"/>
                <ToggleSwitch x:Name="ShowUnknownToggle" x:Uid="ShowUnknownSwitch" IsOn="True"
                              Toggled="ShowUnknownToggle_Toggled" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,8" ColumnDefinitions="*,Auto">
                <TextBox x:Name="SearchBox" x:Uid="SearchBox" TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="SortCombo" Grid.Column="1" Margin="8,0,0,0" Width="140" SelectionChanged="SortCombo_SelectionChanged">
                    <ComboBoxItem x:Uid="SortRssi" Tag="Rssi" IsSelected="True"/>
                    <ComboBoxItem x:Uid="SortName" Tag="Name"/>
                    <ComboBoxItem x:Uid="SortRecent" Tag="Recent"/>
                </ComboBox>
            </Grid>

            <Grid Grid.Row="2">
                <ListView x:Name="DeviceListView" SelectionMode="Single" SelectionChanged="DeviceListView_SelectionChanged"
                          ItemTemplate="{StaticResource DeviceCardTemplate}">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection/>
                    </ListView.ItemContainerTransitions>
                </ListView>

                <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed" Spacing="4">
                    <FontIcon Glyph="&#xE702;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Uid="EmptyDevicesTitle" Style="{StaticResource EmptyStateTitleStyle}"/>
                    <TextBlock x:Uid="EmptyDevicesSubtitle" Style="{StaticResource EmptyStateSubtitleStyle}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Terminal -->
        <Grid x:Name="TerminalPanel" Grid.Column="1" Grid.Row="0" Margin="12,0,0,0"
              RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

            <StackPanel x:Name="StatusChipRow" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <Border Style="{StaticResource StatusChipStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="ConnectionDot" Width="8" Height="8"
                                 Fill="{ThemeResource StatusDisconnectedBrush}"/>
                        <TextBlock x:Name="StatusTextBlock" x:Uid="StatusTextBlock" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusChipStyle}">
                    <TextBlock x:Name="ServerStatusTextBlock" FontSize="12"
                               Foreground="{ThemeResource BrandAccentBrush}"/>
                </Border>
                <Border Style="{StaticResource StatusChipStyle}">
                    <TextBlock x:Name="ByteCountText" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
            </StackPanel>

            <StackPanel x:Name="TerminalToolbar" Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
                <Button x:Name="StartServerButton" x:Uid="StartServerButton" Click="StartServerButton_Click" Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Name="StopServerButton" x:Uid="StopServerButton" Click="StopServerButton_Click" IsEnabled="False"/>
                <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                <Button x:Name="DisconnectButton" x:Uid="DisconnectButton" Click="DisconnectButton_Click" IsEnabled="False"/>
                <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                <Button x:Uid="BtnClearLog" Click="ClearLog_Click"/>
                <Button x:Uid="BtnCopyLog" Click="CopyLog_Click"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,0,0,10">
                <ListView x:Name="TerminalLogList" Style="{StaticResource TerminalLogListStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:TrafficLogEntry">
                            <TextBlock Text="{x:Bind DisplayLine}" FontFamily="Cascadia Mono, Consolas, Courier New"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{x:Bind DirectionBrush}"
                                       Margin="0,1"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="TerminalEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="4" IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE8D7;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Uid="EmptyTerminalTitle" Style="{StaticResource EmptyStateTitleStyle}"/>
                    <TextBlock x:Uid="EmptyTerminalSubtitle" Style="{StaticResource EmptyStateSubtitleStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Presets -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                    <ItemsRepeater x:Name="PresetsRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="6"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:PresetChip">
                                <Button Content="{x:Bind Name}" Tag="{x:Bind Id}" Click="PresetChip_Click" Padding="10,4"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
                <Button Grid.Column="1" x:Uid="BtnAddPreset" Click="AddPreset_Click" Padding="8,4" Margin="8,0,0,0"/>
                <Button x:Name="RunMacroButton" Grid.Column="2" x:Uid="BtnRunMacro" Click="RunMacro_Click" Padding="8,4" Margin="6,0,0,0"/>
            </Grid>

            <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
                <ComboBox x:Name="HistoryCombo" x:Uid="HistoryCombo" IsEditable="False"
                          HorizontalAlignment="Stretch" MinWidth="140" MaxDropDownHeight="280"
                          SelectionChanged="HistoryCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox x:Name="ServiceCombo" Grid.Column="1" Width="200" MinWidth="180" Margin="8,0,0,0"
                          MaxDropDownHeight="280" x:Uid="ServiceCombo">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ToggleSwitch x:Name="HexToggle" Grid.Column="2" x:Uid="SettingsSendAsHex" Margin="8,0,0,0"
                              Toggled="HexToggle_Toggled"/>
            </Grid>

            <Grid Grid.Row="5" ColumnDefinitions="*,Auto">
                <TextBox x:Name="InputTextBox" x:Uid="InputTextBox" KeyDown="InputTextBox_KeyDown"/>
                <Button x:Name="SendButton" x:Uid="SendButton" Grid.Column="1" Click="SendButton_Click"
                        IsEnabled="False" Margin="10,0,0,0" Style="{StaticResource AccentButtonStyle}"/>
            </Grid>
        </Grid>
    </Grid>

        <TeachingTip x:Name="TipScan"
                     Target="{x:Bind ScanButton}"
                     PreferredPlacement="Bottom"
                     ActionButtonClick="Tip_Next"
                     CloseButtonClick="Tip_Skip"/>
        <TeachingTip x:Name="TipDevices"
                     Target="{x:Bind DeviceListView}"
                     PreferredPlacement="Right"
                     ActionButtonClick="Tip_Next"
                     CloseButtonClick="Tip_Skip"/>
        <TeachingTip x:Name="TipTerminal"
                     Target="{x:Bind InputTextBox}"
                     PreferredPlacement="Top"
                     ActionButtonClick="Tip_Next"
                     CloseButtonClick="Tip_Skip"/>
        <TeachingTip x:Name="TipSession"
                     Target="{x:Bind StatusChipRow}"
                     PreferredPlacement="Bottom"
                     ActionButtonClick="Tip_Next"
                     CloseButtonClick="Tip_Skip"/>
    </Grid>
</Page>
