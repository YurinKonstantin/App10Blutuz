<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#0F172A"/>
            <SolidColorBrush x:Key="BrandAccentBrush" Color="#38BDF8"/>
            <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#0B1220"/>
            <SolidColorBrush x:Key="TerminalForegroundBrush" Color="#E2E8F0"/>
            <SolidColorBrush x:Key="TxForegroundBrush" Color="#7DD3FC"/>
            <SolidColorBrush x:Key="RxForegroundBrush" Color="#86EFAC"/>
            <SolidColorBrush x:Key="InfoForegroundBrush" Color="#94A3B8"/>
            <SolidColorBrush x:Key="StatusConnectedBrush" Color="#22C55E"/>
            <SolidColorBrush x:Key="StatusDisconnectedBrush" Color="#94A3B8"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#0F172A"/>
            <SolidColorBrush x:Key="BrandAccentBrush" Color="#0284C7"/>
            <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#F1F5F9"/>
            <SolidColorBrush x:Key="TerminalForegroundBrush" Color="#0F172A"/>
            <SolidColorBrush x:Key="TxForegroundBrush" Color="#0369A1"/>
            <SolidColorBrush x:Key="RxForegroundBrush" Color="#15803D"/>
            <SolidColorBrush x:Key="InfoForegroundBrush" Color="#64748B"/>
            <SolidColorBrush x:Key="StatusConnectedBrush" Color="#16A34A"/>
            <SolidColorBrush x:Key="StatusDisconnectedBrush" Color="#64748B"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Thickness x:Key="DeviceCardPadding">12</Thickness>
    <Thickness x:Key="DeviceCardPaddingCompact">8</Thickness>
    <Thickness x:Key="DeviceCardMargin">0,4,0,4</Thickness>
    <Thickness x:Key="DeviceCardMarginCompact">0,2,0,2</Thickness>

    <Style x:Key="TerminalLogStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{ThemeResource TerminalBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TerminalForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style x:Key="TerminalLogListStyle" TargetType="ListView">
        <Setter Property="Background" Value="{ThemeResource TerminalBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="SelectionMode" Value="None"/>
        <Setter Property="IsItemClickEnabled" Value="False"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style x:Key="DeviceCardBorderStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="{StaticResource DeviceCardPadding}"/>
        <Setter Property="Margin" Value="{StaticResource DeviceCardMargin}"/>
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    </Style>

    <Style x:Key="DeviceCardBorderCompactStyle" TargetType="Border" BasedOn="{StaticResource DeviceCardBorderStyle}">
        <Setter Property="Padding" Value="{StaticResource DeviceCardPaddingCompact}"/>
        <Setter Property="Margin" Value="{StaticResource DeviceCardMarginCompact}"/>
    </Style>

    <Style x:Key="PanelCardStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    </Style>

    <Style x:Key="EmptyStateTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,8,0,4"/>
    </Style>

    <Style x:Key="EmptyStateSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="360"/>
    </Style>

    <Style x:Key="TypeBadgeBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,1,6,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="StatusChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,4,10,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    </Style>

    <Style x:Key="SettingsCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SettingsCardDescStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PageInfoBarStyle" TargetType="InfoBar">
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="IsClosable" Value="True"/>
    </Style>
</ResourceDictionary>
