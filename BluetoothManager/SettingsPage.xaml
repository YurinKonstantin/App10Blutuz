<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BluetoothManager.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BluetoothManager"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="640" Spacing="4">
            <TextBlock x:Uid="SettingsTitle" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>

            <TextBlock x:Uid="SettingsAppearanceHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,8"/>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock x:Uid="SettingsThemeTitle" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock x:Uid="SettingsThemeDesc" Style="{StaticResource SettingsCardDescStyle}"/>
                    </StackPanel>
                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" MinWidth="160" VerticalAlignment="Center"
                              SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Tag="System" x:Uid="ThemeSystem"/>
                        <ComboBoxItem Tag="Light" x:Uid="ThemeLight"/>
                        <ComboBoxItem Tag="Dark" x:Uid="ThemeDark"/>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock x:Uid="SettingsCompactTitle" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock x:Uid="SettingsCompactDesc" Style="{StaticResource SettingsCardDescStyle}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="CompactToggle" Grid.Column="1" VerticalAlignment="Center"
                                  Toggled="CompactToggle_Toggled"/>
                </Grid>
            </Border>

            <TextBlock x:Uid="SettingsScannerHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,8"/>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock x:Uid="SettingsSortTitle" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock x:Uid="SettingsSortDesc" Style="{StaticResource SettingsCardDescStyle}"/>
                    </StackPanel>
                    <ComboBox x:Name="SortCombo" Grid.Column="1" MinWidth="160" VerticalAlignment="Center"
                              SelectionChanged="SortCombo_SelectionChanged">
                        <ComboBoxItem Tag="Rssi" x:Uid="SortRssi"/>
                        <ComboBoxItem Tag="Name" x:Uid="SortName"/>
                        <ComboBoxItem Tag="Recent" x:Uid="SortRecent"/>
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock x:Uid="SettingsTerminalHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,8"/>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock x:Uid="SettingsLineEndingTitle" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock x:Uid="SettingsLineEndingDesc" Style="{StaticResource SettingsCardDescStyle}"/>
                    </StackPanel>
                    <ComboBox x:Name="LineEndingCombo" Grid.Column="1" MinWidth="160" VerticalAlignment="Center"
                              SelectionChanged="LineEndingCombo_SelectionChanged">
                        <ComboBoxItem Tag="Lf" x:Uid="LineEndingLf"/>
                        <ComboBoxItem Tag="CrLf" x:Uid="LineEndingCrLf"/>
                        <ComboBoxItem Tag="Cr" x:Uid="LineEndingCr"/>
                        <ComboBoxItem Tag="None" x:Uid="LineEndingNone"/>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock x:Uid="SettingsSendAsHexTitle" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock x:Uid="SettingsSendAsHexDesc" Style="{StaticResource SettingsCardDescStyle}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="SendAsHexToggle" Grid.Column="1" VerticalAlignment="Center"
                                  Toggled="SendAsHexToggle_Toggled"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock x:Uid="SettingsAutoReconnectTitle" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock x:Uid="SettingsAutoReconnectDesc" Style="{StaticResource SettingsCardDescStyle}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoReconnectToggle" Grid.Column="1" VerticalAlignment="Center"
                                  Toggled="AutoReconnectToggle_Toggled"/>
                </Grid>
            </Border>

            <TextBlock x:Uid="SettingsPresetsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,8"/>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsPresetsTitle" Style="{StaticResource SettingsCardTitleStyle}"/>
                    <TextBlock x:Uid="SettingsPresetsDesc" Style="{StaticResource SettingsCardDescStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button x:Uid="BtnExportPresets" Click="ExportPresets_Click"/>
                        <Button x:Uid="BtnImportPresets" Click="ImportPresets_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Uid="SettingsLicenseHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,8"/>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock x:Uid="SettingsLicenseTitle" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock x:Name="LicenseStatusText" Style="{StaticResource SettingsCardDescStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="BuyProSettingsButton"
                                Click="BuyPro_Click"
                                Style="{StaticResource AccentButtonStyle}"/>
                        <Button x:Name="RefreshLicenseButton"
                                Click="RefreshLicense_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Uid="SettingsAboutHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,8"/>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsAboutText" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button x:Uid="BtnRateApp" Click="RateApp_Click" HorizontalAlignment="Left"/>
                    <Button x:Name="PrivacyPolicyButton" Click="PrivacyPolicy_Click" HorizontalAlignment="Left"/>
                    <Button x:Uid="BtnShowOnboarding" Click="ShowOnboarding_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="StoreScreenshotPanel" Visibility="Collapsed" Spacing="4" Margin="0,16,0,0">
                <TextBlock Text="Store screenshots (Debug)" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Capture scene: demo data for the selected shot, then PNG to Pictures\BlueIDE-Store\. Tours also save under language folders."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12"/>
                        <ComboBox x:Name="StoreSceneCombo" MinWidth="280" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CaptureStoreShotButton" Content="Capture scene"
                                    Click="CaptureStoreShot_Click" HorizontalAlignment="Left"/>
                            <Button x:Name="RunStoreTourButton" Content="Run auto tour (en + ru)"
                                    Click="RunStoreTour_Click" HorizontalAlignment="Left"
                                    Style="{StaticResource AccentButtonStyle}"/>
                            <Button x:Name="RunStoreTourAllLangButton" Content="Tour all languages"
                                    Click="RunStoreTourAllLang_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
